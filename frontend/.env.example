# Copy to .env.local (ignored by Git) and restart `npm run dev` after editing.

# Backend started by `docker compose up` in the repository root.
BACKEND_URL=http://localhost:8080/movie-recommendation

# Optional. Both keys are needed to look up trailers for movies that have none in SQL;
# without them the detail view shows a "Search for a trailer on YouTube" link instead.
TMDB_KEY=
YOUTUBE_API_KEY=
