QDRANT_HOST_PORT=6335
QDRANT_URL=http://localhost:6335
QDRANT_COLLECTION=movies

# Only use cuda:0 on a host with a working NVIDIA driver and CUDA PyTorch.
# The default Docker AI image uses CPU regardless of this host-side setting.
EMBEDDING_DEVICE=cpu

# Week 5 optional search reranking; model loads only for rerank=true.
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
# RERANKER_MODEL_PATH=/path/to/local/model
RERANKER_DEVICE=cpu
RETRIEVAL_CANDIDATE_K=50
RETRIEVAL_FINAL_K=10

# Final recommendation ranking, enabled per request with ranking=final.
RECOMMENDATION_SIMILARITY_WEIGHT=0.8
RECOMMENDATION_IMDB_WEIGHT=0.2
