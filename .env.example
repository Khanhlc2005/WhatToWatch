QDRANT_HOST_PORT=6335
QDRANT_URL=http://localhost:6335
QDRANT_COLLECTION=movies

# Ollama model used by RAG chat. Keep the base tag for rollback.
# After importing and validating the merged SFT model, set this to
# whattowatch-qwen25-3b-sft:english-v1.
OLLAMA_MODEL_NAME=qwen2.5:3b

# Only use cuda:0 on a host with a working NVIDIA driver and CUDA PyTorch.
# The default Docker AI image uses CPU regardless of this host-side setting.
EMBEDDING_DEVICE=cpu

# Week 5 optional search reranking; model loads only for rerank=true.
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
# In Docker, a downloaded host model under data/model_cache is mounted at /model-cache.
# RERANKER_MODEL_PATH=/model-cache/models--BAAI--bge-reranker-v2-m3/snapshots/<revision>
RERANKER_DEVICE=cpu
RETRIEVAL_CANDIDATE_K=50
RETRIEVAL_FINAL_K=10

# Final recommendation ranking, enabled per request with ranking=final.
RECOMMENDATION_SIMILARITY_WEIGHT=0.8
RECOMMENDATION_IMDB_WEIGHT=0.2

# CPU reranking can exceed the previous 35-second Backend read timeout.
AI_SERVICE_SEARCH_TIMEOUT_SECONDS=120
